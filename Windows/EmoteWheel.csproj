<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <AssemblyName>EmoteWheel</AssemblyName>
    <RootNamespace>EmoteWheel</RootNamespace>
    <Version>1.2.0</Version>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
    <Content Include="../Resources/emotes.json" Link="Resources/emotes.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Resources/emotes/*.png" Link="Resources/emotes/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../SOURCES.md" Link="SOURCES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
